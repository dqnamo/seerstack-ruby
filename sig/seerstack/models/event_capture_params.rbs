module Seerstack
  module Models
    type event_capture_params =
      {
        name: String,
        data: ::Hash[Symbol, top?],
        timestamp: Time,
        user_id: String
      }
      & Seerstack::Internal::Type::request_parameters

    class EventCaptureParams < Seerstack::Internal::Type::BaseModel
      extend Seerstack::Internal::Type::RequestParameters::Converter
      include Seerstack::Internal::Type::RequestParameters

      attr_accessor name: String

      attr_reader data: ::Hash[Symbol, top?]?

      def data=: (::Hash[Symbol, top?]) -> ::Hash[Symbol, top?]

      attr_reader timestamp: Time?

      def timestamp=: (Time) -> Time

      attr_reader user_id: String?

      def user_id=: (String) -> String

      def initialize: (
        name: String,
        ?data: ::Hash[Symbol, top?],
        ?timestamp: Time,
        ?user_id: String,
        ?request_options: Seerstack::request_opts
      ) -> void

      def to_hash: -> {
        name: String,
        data: ::Hash[Symbol, top?],
        timestamp: Time,
        user_id: String,
        request_options: Seerstack::RequestOptions
      }
    end
  end
end
